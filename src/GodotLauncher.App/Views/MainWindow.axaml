<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GodotLauncher.App.ViewModels"
        xmlns:views="using:GodotLauncher.App.Views"
        xmlns:dl="using:GodotLauncher.App.Downloads"
        xmlns:mvvm="using:GodotLauncher.App.Mvvm"
             xmlns:controls="using:GodotLauncher.App.Controls"
        x:Class="GodotLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppName}"
        Width="1140" Height="750" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        KeyDown="OnWindowKeyDown">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding ToggleDownloadsCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Grid#PageHost">
      <Setter Property="Margin" Value="24,18,24,20" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="238,*">
    <!-- Sidebar fills the full window height. -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,10,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="4,0,0,16"
                    PointerPressed="OnTitleBarPointerPressed" Background="Transparent">
          <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True">
            <Image Source="avares://GodotLauncher/Assets/app.png" Stretch="UniformToFill" />
          </Border>
          <TextBlock Text="{Binding AppName}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Classes="divider" Margin="4,0" />
          <Button Classes="nav" Command="{Binding ToggleDownloadsCommand}" Classes.active="{Binding IsDownloadsOpen}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{DynamicResource IconDownload}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text.Downloads.Title}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding DownloadsCountText}" VerticalAlignment="Center"
                         IsVisible="{Binding HasDownloadsCount}" />
            </Grid>
          </Button>
          <Grid ColumnDefinitions="Auto,*" Margin="4,0,0,0" ColumnSpacing="8">
            <TextBlock Classes="caption" Text="{Binding VersionText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Width="112" Height="26" Padding="0" HorizontalAlignment="Right" Classes="primary update"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding Updates.ApplyCommand}" IsVisible="{Binding Updates.CanAct}"
                    ToolTip.Tip="{Binding Updates.StatusText}">
              <Grid>
                <controls:ProgressFill IsVisible="{Binding Updates.IsDownloading}"
                                       Progress="{Binding Updates.Progress}"
                                       CornerRadius="8" />
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="6,0">
                  <Path Classes="stop" Data="{DynamicResource IconStop}" Width="8" Height="8" Stretch="Uniform" Fill="White"
                        VerticalAlignment="Center" IsVisible="{Binding Updates.IsDownloading}" />
                  <TextBlock Text="{Binding Updates.ActionText}" FontSize="11" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Button>
          </Grid>
        </StackPanel>

        <StackPanel Spacing="3">
          <Button Classes="nav" Classes.active="{Binding IsProjectsSelected}" Command="{Binding ShowProjectsCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{DynamicResource IconProject}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text.Nav.Projects}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding ProjectsCountText}" VerticalAlignment="Center"
                         IsVisible="{Binding HasProjectsCount}" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsExploreSelected}" Command="{Binding ShowExploreCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{DynamicResource IconExplore}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text.Nav.Explore}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsInstalledSelected}" Command="{Binding ShowInstalledCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{DynamicResource IconInstalled}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text.Nav.Installed}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="caption" Text="{Binding InstalledCountText}" VerticalAlignment="Center"
                         IsVisible="{Binding HasInstalledCount}" />
            </Grid>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsSettingsSelected}" Command="{Binding ShowSettingsCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Data="{DynamicResource IconSettings}" Width="15" Height="15" Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Text.Nav.Settings}" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content column: window chrome on top, then banner, network hint and pages. -->
    <Grid Grid.Column="1" RowDefinitions="42,Auto,Auto,*">
      <Grid Grid.Row="0" x:Name="TitleBar" ColumnDefinitions="*,Auto" Background="Transparent"
            PointerPressed="OnTitleBarPointerPressed" DoubleTapped="OnTitleBarDoubleTapped">
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" Spacing="2">
          <Button Classes="titlebar" Click="OnMinimizeClick" ToolTip.Tip="{Binding Text.Common.Close}">
            <Path Data="{DynamicResource IconMinimize}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
          </Button>
          <Button Classes="titlebar" Click="OnMaximizeClick">
            <Path Data="{DynamicResource IconMaximize}" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
          </Button>
          <Button Classes="titlebar close" Click="OnCloseClick">
            <Path Data="{DynamicResource IconClose}" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" IsVisible="{Binding IsBannerVisible}" Margin="24,16,24,0" Padding="14,10" CornerRadius="10"
              Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Classes="caption" Text="{Binding BannerDetail}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" Command="{Binding DismissBannerCommand}"
                  Content="{Binding Text.Banner.Dismiss}" />
        </Grid>
      </Border>

      <Border Grid.Row="2" IsVisible="{Binding HasNetworkIssue}" Margin="24,12,24,0" Padding="12,8" CornerRadius="8"
              Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="{Binding NetworkIssueTitle}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Classes="caption" Text="{Binding NetworkIssue}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding NetworkIssueDetail}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" FontSize="12" MinHeight="26" Padding="9,3"
                  Content="{Binding NetworkIssueAction}" Command="{Binding OpenNetworkSettingsCommand}" />
        </Grid>
      </Border>

      <Grid x:Name="PageHost" Grid.Row="3">
        <Panel IsVisible="{Binding IsProjectsSelected}">
          <ContentControl x:Name="ProjectsHost" />
        </Panel>
        <Panel IsVisible="{Binding IsExploreSelected}">
          <views:ExploreView DataContext="{Binding Explore}" />
        </Panel>
        <Panel IsVisible="{Binding IsInstalledSelected}">
          <ContentControl x:Name="InstalledHost" />
        </Panel>
        <Panel IsVisible="{Binding IsSettingsSelected}">
          <ContentControl x:Name="SettingsHost" />
        </Panel>
      </Grid>

      <!-- Downloads drawer floats above the page instead of reflowing it. -->
      <Border Grid.Row="3" IsVisible="{Binding IsDownloadsOpen}" Width="392" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0"
              BoxShadow="-14 0 32 0 #66000000">
        <Grid RowDefinitions="Auto,*" Margin="16">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,12">
            <StackPanel Spacing="1">
              <TextBlock Classes="h2" Text="{Binding Text.Downloads.Title}" />
              <TextBlock Classes="caption" Text="{Binding DownloadsCountText}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" FontSize="12" MinHeight="30" Padding="10,4" Margin="0,0,4,0"
                    Command="{Binding ClearFinishedDownloadsCommand}" Content="{Binding Text.Downloads.Clear}"
                    IsVisible="{Binding HasDownloads}" />
            <Button Grid.Column="2" Classes="ghost" Width="30" Height="30" Padding="0" Command="{Binding CloseDownloadsCommand}">
              <Path Data="{DynamicResource IconClose}" Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" />
            </Button>
          </Grid>

          <Panel Grid.Row="1">
            <ListBox ItemsSource="{Binding Downloads}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dl:DownloadItem">
                  <Border Classes="card" Padding="12,10">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="caption" Text="{Binding MetaText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="caption" Text="{Binding StatusText}" VerticalAlignment="Center" />
                      </Grid>

                      <ProgressBar Value="{Binding Progress}" Maximum="1" IsVisible="{Binding IsActive}" />
                      <TextBlock Classes="caption" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsActive}" />
                      <TextBlock Classes="caption danger" Text="{Binding ErrorMessage}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />

                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="ghost" FontSize="12" MinHeight="28" Padding="9,4" Content="{Binding CancelText}"
                                Command="{Binding CancelDownloadCommand}" IsVisible="{Binding CanCancel}" />
                        <Button Classes="ghost" FontSize="12" MinHeight="28" Padding="9,4" Content="{Binding RetryText}"
                                Command="{Binding RetryDownloadCommand}" IsVisible="{Binding CanRetry}" />
                        <Button Classes="ghost" FontSize="12" MinHeight="28" Padding="9,4" Content="{Binding RemoveText}"
                                Command="{Binding RemoveDownloadCommand}" IsVisible="{Binding IsFinished}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasDownloads}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" MaxWidth="240">
              <TextBlock Classes="h2 center" Text="{Binding Text.Downloads.Title}" />
              <TextBlock Classes="caption center wrap" Text="{Binding Text.Downloads.EmptyHint}" />
            </StackPanel>
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <!-- Modal dialog -->
    <Panel Grid.ColumnSpan="2" IsVisible="{Binding HasDialog}" Background="{DynamicResource OverlayBrush}">
      <Border Classes="panel" Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              BoxShadow="0 20 48 0 #66000000"
              DataContext="{Binding Dialog}" x:DataType="mvvm:DialogViewModel">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="body" Text="{Binding Message}" TextWrapping="Wrap" />
          <TextBox Text="{Binding InputText}" Watermark="{Binding Placeholder}" IsVisible="{Binding IsPrompt}" />
          <CheckBox Content="{Binding OptionText}" IsChecked="{Binding OptionValue}" IsVisible="{Binding HasOption}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Classes="ghost" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
            <Button Classes.primary="{Binding !IsDanger}" Classes.solid-danger="{Binding IsDanger}" Content="{Binding PrimaryText}" Command="{Binding ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</Window>
