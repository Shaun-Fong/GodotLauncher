<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodotLauncher.App.ViewModels"
             xmlns:controls="using:GodotLauncher.App.Controls"
             x:Class="GodotLauncher.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" MaxWidth="800" HorizontalAlignment="Left">
      <StackPanel Spacing="3" Margin="0,0,0,4">
        <TextBlock Classes="h1" Text="{Binding Text.Settings.Title}" />
        <TextBlock Classes="body" Text="{Binding Text.Settings.Subtitle}"  TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.Appearance}" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Theme}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Language}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.Behavior}" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.CloseBehavior}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding CloseBehaviors}" SelectedItem="{Binding SelectedCloseBehavior}" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.AfterLaunch}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding AfterLaunchBehaviors}" SelectedItem="{Binding SelectedAfterLaunch}" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.LaunchConsole}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <CheckBox Grid.Column="1" IsChecked="{Binding LaunchWithConsole}" />
          </Grid>
          <Grid ColumnDefinitions="200,*" IsVisible="{Binding AutostartSupported}">
            <TextBlock Text="{Binding Text.Settings.Autostart}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding Autostart}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.Downloads}" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.InstallRoot}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding InstallRoot}" Watermark="{Binding Text.Settings.InstallRootHint}" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="{Binding Text.Settings.Browse}" Command="{Binding BrowseInstallRootCommand}" />
              <Button Grid.Column="2" Margin="6,0,0,0" Content="{Binding Text.Common.Save}" Command="{Binding SaveInstallRootCommand}" />
            </Grid>
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Concurrent}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="120" ItemsSource="{Binding ParallelDownloadOptions}" SelectedItem="{Binding SelectedParallelDownloads}" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Mirror}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding MirrorTemplate}" Watermark="{Binding Text.Settings.MirrorHint}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{Binding Text.Common.Save}" Command="{Binding SaveMirrorTemplateCommand}" />
            </Grid>
          </Grid>
          <TextBlock Classes="caption" Margin="200,0,0,0" TextWrapping="Wrap" Text="{Binding Text.Settings.MirrorHint}" />
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.Updates}" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.RefreshInterval}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200" ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding SelectedRefreshInterval}" />
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.ShowOlder}" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" IsChecked="{Binding ShowOlderVersions}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.Notifications}" />
          <TextBlock Classes="caption" Text="{Binding Text.Settings.NotificationsHint}" TextWrapping="Wrap" />
          <WrapPanel>
            <CheckBox Content="{Binding Text.Channel.Stable}" IsChecked="{Binding NotifyStable}" Margin="0,0,18,0" />
            <CheckBox Content="{Binding Text.Channel.RC}" IsChecked="{Binding NotifyRc}" Margin="0,0,18,0" />
            <CheckBox Content="{Binding Text.Channel.Beta}" IsChecked="{Binding NotifyBeta}" Margin="0,0,18,0" />
            <CheckBox Content="{Binding Text.Channel.Dev}" IsChecked="{Binding NotifyDev}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="10">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.Network}" />
          <TextBlock Classes="caption" Text="{Binding Text.Settings.NetworkHint}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Proxy}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding SelectedProxy}" />
          </Grid>
          <Grid ColumnDefinitions="200,*,Auto">
            <TextBlock Text="{Binding Text.Settings.ProxyUrl}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding ProxyUrl}" Watermark="http://127.0.0.1:7890" />
            <Button Grid.Column="2" Classes="ghost" Margin="8,0,0,0" Content="{Binding Text.Common.Save}" Command="{Binding SaveProxyUrlCommand}" />
          </Grid>
          <TextBlock Classes="caption" Margin="200,0,0,0" Text="{Binding Text.Settings.ProxyUrlHint}" TextWrapping="Wrap" />
          <TextBlock Classes="caption danger" Margin="200,2,0,0" Text="{Binding ProxyError}"
                     IsVisible="{Binding HasProxyError}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="panel" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="section-title" Text="{Binding Text.Settings.About}" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Version}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding VersionText}" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="200,*,Auto">
            <TextBlock Text="{Binding Text.Settings.CheckUpdates}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Updates.StatusText}" VerticalAlignment="Center"
                       Margin="0,0,10,0" TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="{Binding Text.Settings.CheckNow}"
                      Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !Updates.IsChecking}" />
              <Button Width="200" Height="34" Padding="0" Classes="primary"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      Command="{Binding Updates.ApplyCommand}" IsVisible="{Binding Updates.CanAct}">
                <Grid>
                  <controls:ProgressFill IsVisible="{Binding Updates.IsDownloading}"
                                         Progress="{Binding Updates.Progress}"
                                         CornerRadius="8"
                                         Track="{DynamicResource AccentSoftBrush}"
                                         Fill="{DynamicResource AccentHoverBrush}" />
                  <TextBlock Text="{Binding Updates.ActionText}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="8,0" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.DataFolder}" VerticalAlignment="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding DataFolder}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Classes="ghost" Content="{Binding Text.Settings.Open}" Command="{Binding OpenDataFolderCommand}" />
            </Grid>
          </Grid>
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="{Binding Text.Settings.Logs}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Left" Content="{Binding Text.Settings.Open}" Command="{Binding OpenLogsCommand}" />
          </Grid>
          <Grid ColumnDefinitions="200,*,Auto">
            <TextBlock Text="{Binding Text.Settings.Repository}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding RepositoryUrl}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
            <Button Grid.Column="2" Classes="ghost" Content="{Binding Text.Settings.Open}"
                    Command="{Binding OpenRepositoryCommand}" />
          </Grid>
          <TextBlock Classes="caption" Text="{Binding LicenseText}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="caption" Margin="2,0,0,10" Text="{Binding SavedText}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
