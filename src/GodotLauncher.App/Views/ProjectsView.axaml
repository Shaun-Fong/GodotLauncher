<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodotLauncher.App.ViewModels"
             x:Class="GodotLauncher.App.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Classes="h1" Text="{Binding Text.Projects.Title}" />
        <TextBlock Classes="body" Text="{Binding Text.Projects.Subtitle}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="ghost" Command="{Binding ImportCommand}">
          <TextBlock Text="{Binding Text.Projects.ImportTitle}" FontSize="13" />
        </Button>
        <Button Classes="primary" Command="{Binding CreateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="{DynamicResource IconAdd}" Width="14" Height="14" Stretch="Uniform" Fill="White" />
            <TextBlock Text="{Binding Text.Projects.Create}" Foreground="White" FontSize="13" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,18,0,10">
      <TextBox Width="260" Watermark="{Binding Text.Projects.Search}" Text="{Binding SearchText}" />
      <TextBlock Grid.Column="1" Classes="caption" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Text="{Binding CountText}" />
    </Grid>

    <Panel Grid.Row="2">
      <ListBox ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectItemViewModel">
            <Border Classes="card hover" Padding="14,10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Button Classes="rowlink" Command="{Binding LaunchCommand}" ToolTip.Tip="{Binding PathText}">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="card-title" Text="{Binding Title}" VerticalAlignment="Center" />
                      <Border Classes="pill warning" IsVisible="{Binding HasWarning}">
                        <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>

                <ComboBox Grid.Column="1" Width="270" VerticalAlignment="Center"
                          ItemsSource="{Binding Editors}"
                          SelectedItem="{Binding SelectedEditor}"
                          PlaceholderText="{Binding L.Projects.SelectVersion}"
                          IsEnabled="{Binding HasEditors}" />

                <Button Grid.Column="2" Classes="ghost" Width="34" Height="34" Padding="0"
                        VerticalAlignment="Center" ToolTip.Tip="{Binding L.Projects.More}">
                  <Path Data="{DynamicResource IconMore}" Width="16" Height="16" Stretch="Uniform"
                        Fill="{DynamicResource TextSecondaryBrush}" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="{Binding L.Projects.ReloadInfo}" Command="{Binding ReloadInfoCommand}" />
                      <MenuItem Header="{Binding L.Projects.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                      <Separator />
                      <MenuItem Header="{Binding L.Projects.Remove}" Command="{Binding RemoveCommand}" />
                      <MenuItem Header="{Binding L.Projects.RemoveFromDisk}" Command="{Binding DeleteFromDiskCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
        <TextBlock Classes="h2 center" Text="{Binding EmptyText}" />
        <TextBlock Classes="body center wrap" Text="{Binding EmptyHintText}" />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
