<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GodotLauncher.App.ViewModels"
             x:Class="GodotLauncher.App.Views.ExploreView"
             x:DataType="vm:ExploreViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Classes="h1" Text="{Binding Text.Explore.Title}" />
        <TextBlock Classes="body" Text="{Binding Text.Explore.Subtitle}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsRefreshing}"
              MinWidth="104" VerticalAlignment="Center" Margin="16,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Path Data="{DynamicResource IconRefresh}" Width="14" Height="14" Stretch="Uniform"
                Fill="{DynamicResource AccentBrush}" />
          <TextBlock Text="{Binding Text.Explore.Refresh}" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
        </StackPanel>
      </Button>
    </Grid>

    <WrapPanel Grid.Row="1" Margin="0,20,0,0" Orientation="Horizontal">
      <TextBox Width="220" Margin="0,0,10,8" Text="{Binding SearchText}" Watermark="{Binding Text.Explore.Search}" MinHeight="36" />
      <ComboBox Width="150" Margin="0,0,10,8" ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" MinHeight="36" />
      <ComboBox Width="130" Margin="0,0,10,8" ItemsSource="{Binding Editions}" SelectedItem="{Binding SelectedEdition}" MinHeight="36" />
      <ComboBox Width="120" Margin="0,0,10,8" ItemsSource="{Binding Architectures}" SelectedItem="{Binding SelectedArchitecture}" MinHeight="36" />
      <CheckBox Margin="4,0,0,8" Content="{Binding Text.Explore.ShowOlder}" IsChecked="{Binding ShowOlderVersions}" VerticalAlignment="Center" />
    </WrapPanel>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,14,2,10">
      <TextBlock Classes="caption" Text="{Binding CountText}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="0,0,12,0" VerticalAlignment="Center">
        <TextBlock Classes="caption" Text="{Binding StatusText}" />
        <TextBlock Classes="caption" Text="{Binding UpdatedText}" />
      </StackPanel>
      <ProgressBar Grid.Column="3" IsIndeterminate="True" IsVisible="{Binding IsRefreshing}" Width="90" Height="3" VerticalAlignment="Center" />
    </Grid>

    <Panel Grid.Row="3">
      <ListBox ItemsSource="{Binding Versions}" IsVisible="{Binding !IsEmpty}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:VersionCardViewModel">
            <Border Classes="card hover" Padding="14,12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="7">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="card-title" Text="{Binding Title}" VerticalAlignment="Center" />
                    <Border Classes="pill" Classes.stable="{Binding IsStable}" Classes.rc="{Binding IsRc}" Classes.beta="{Binding IsBeta}" Classes.dev="{Binding IsDev}">
                      <TextBlock Text="{Binding ChannelText}" />
                    </Border>
                    <Border Classes="badge" IsVisible="{Binding IsNew}">
                      <TextBlock Text="{Binding NewText}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="caption" Text="{Binding MetaText}" />
                </StackPanel>

                <Button Grid.Column="1" Classes="primary" Classes.success="{Binding IsInstalled}" MinWidth="112"
                        VerticalAlignment="Center" Command="{Binding PrimaryCommand}" Content="{Binding ActionText}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="380">
        <TextBlock Classes="h2 center" Text="{Binding Text.Explore.Empty}" />
        <TextBlock Classes="body center wrap" Text="{Binding Text.Explore.EmptyHint}" />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>
